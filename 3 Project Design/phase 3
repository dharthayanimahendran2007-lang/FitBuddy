<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FitBuddy - Project Design</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f0fdf4;
      color: #183b2b;
    }
    header {
      background: #166534;
      color: white;
      padding: 20px;
      text-align: center;
    }
    nav {
      display: flex;
      justify-content: center;
      gap: 18px;
      flex-wrap: wrap;
      padding: 15px;
      background: white;
    }
    nav a {
      color: #166534;
      text-decoration: none;
      font-weight: bold;
    }
    main {
      max-width: 850px;
      margin: 25px auto;
      padding: 15px;
    }
    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 15px;
    }
    .card {
      background: white;
      border-radius: 14px;
      padding: 22px;
      text-align: center;
      box-shadow: 0 3px 12px #0001;
    }
    .card button {
      background: #16a34a;
      color: white;
      padding: 10px 15px;
      border: 0;
      border-radius: 7px;
      cursor: pointer;
    }
    #message {
      text-align: center;
      margin-top: 20px;
      font-weight: bold;
    }
  </style>
</head>
<body>
  <header>
    <h1>FitBuddy 💚</h1>
    <p>Your Personal Fitness Companion</p>
  </header>

  <nav>
    <a href="#home">Home</a>
    <a href="#goals">Fitness Goals</a>
    <a href="#about">About</a>
  </nav>

  <main id="home">
    <h2>Welcome to FitBuddy</h2>
    <p>Explore the design of your personal fitness planning website.</p>

    <section id="goals">
      <h2>Choose Your Fitness Goal</h2>
      <div class="cards">
        <div class="card">
          <h3>🏃 General Fitness</h3>
          <p>Build a regular activity routine.</p>
          <button onclick="chooseGoal('General Fitness')">Select</button>
        </div>

        <div class="card">
          <h3>💪 Strength</h3>
          <p>Explore strength-building activities.</p>
          <button onclick="chooseGoal('Strength')">Select</button>
        </div>

        <div class="card">
          <h3>🧘 Flexibility</h3>
          <p>Explore stretching and mobility.</p>
          <button onclick="chooseGoal('Flexibility')">Select</button>
        </div>
      </div>
      <p id="message" aria-live="polite"></p>
    </section>

    <section id="about">
      <h2>About FitBuddy</h2>
      <p>FitBuddy is a student project designed to make
      fitness planning simple and accessible.</p>
    </section>
  </main>

  <script>
    function chooseGoal(goal) {
      document.getElementById("message").textContent =
        "You selected: " + goal;
    }
  </script>
</body>
</html>
